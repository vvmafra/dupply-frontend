# Environment — Dupply Frontend
# Copy to .env.local for local overrides (gitignored).

# --- Mock mode (default) ---
VITE_USE_MOCKS=true
# VITE_API_BASE_URL=

# --- Switch to REST API (when backend is ready) ---
# 1. Uncomment and set both lines below
# 2. Restart `npm run dev`
# VITE_USE_MOCKS=false
# VITE_API_BASE_URL=http://localhost:3000/api

# Optional request timeout (ms)
# VITE_API_TIMEOUT_MS=30000

# --- Stellar / WebAuthn (seller smart wallet — HTTP mode only) ---
# Required when VITE_USE_MOCKS=false and seller wallet flow is active.
# v1: testnet only. Mainnet and relayer integration are deferred to a future iteration.

# Soroban RPC (testnet)
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Smart account WASM hash and WebAuthn verifier (smart-account-kit testnet defaults)
VITE_ACCOUNT_WASM_HASH=8537b8166c0078440a5324c12f6db48d6340d157c306a54c5ea81405abcc2611
VITE_WEBAUTHN_VERIFIER_ADDRESS=CCMR63YE5T7MPWREF3PC5XNTTGXFSB4GYUGUIT5POHP2UGCS65TBIUUU

# Network sent to backend on wallet registration (v1: testnet only)
VITE_STELLAR_NETWORK=testnet

# WebAuthn relying party — MUST match the page origin (secure context requirement).
# Local dev: localhost | Production (Vercel): dupply-frontend.vercel.app
VITE_WEBAUTHN_RP_ID=localhost
VITE_WEBAUTHN_RP_NAME=Dupply

# Optional: native XLM token contract for Friendbot auto-funding (SDK testnet default if omitted)
# VITE_STELLAR_NATIVE_TOKEN_CONTRACT=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Deferred — not used in v1:
# VITE_RELAYER_URL=   (fee sponsoring / relayer proxy)
# Mainnet passphrase, WASM hash, and verifier addresses — future env profile
