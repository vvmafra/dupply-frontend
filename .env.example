# Environment — Dupply Frontend
# Copy to .env.local for local overrides (gitignored).

# --- Mock mode (default) ---
VITE_USE_MOCKS=true
# VITE_API_BASE_URL=

# --- Switch to REST API (dupply-backend, branch feat/demo-local) ---
# 1. Uncomment and set both lines below (the backend listens on 8080 by default;
#    routes are served under /v1, so no path suffix here)
# 2. Seed the backend: `npm run seed:dev` (accounts *@dupply.dev.local / dev-password-change-me)
# 3. Restart `npm run dev`
# VITE_USE_MOCKS=false
# VITE_API_BASE_URL=http://localhost:8080

# Optional request timeout (ms)
# VITE_API_TIMEOUT_MS=30000
